# SampleSeva backend environment
# Copy this file to .env and fill in real values. Never commit .env.

# development | production | test
NODE_ENV=development

# Port the Express server listens on.
PORT=4000

# Origin of the React frontend (used for CORS with credentials).
# Development: http://localhost:5173 (the Vite dev server).
# Production:  the deployed frontend origin, e.g. https://app.sampleseva.example.com
CLIENT_URL=http://localhost:5173

# MongoDB connection string (REQUIRED in all environments — the server will
# not start without it). Use a MongoDB Atlas URI in production.
MONGODB_URI=mongodb://127.0.0.1:27017/sampleseva

# JWT signing secret. Use a long random string in production
# (required in production and must be at least 32 characters).
JWT_SECRET=replace-with-a-long-random-secret
