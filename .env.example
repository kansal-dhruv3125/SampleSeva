# SampleSeva frontend environment (Vite)
# Copy this file to .env (or set the variables in your build environment) and
# fill in real values. Never commit .env — it is git-ignored.
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle.

# Base URL of the SampleSeva backend API.
#   - Development default (when unset): http://localhost:4000
#   - Production default (when unset):  same origin as the frontend
#     (works when the frontend and API are served behind one domain/proxy)
#   - Set this when the API is hosted on a different origin, e.g.:
#     https://api.sampleseva.example.com
VITE_API_URL=
